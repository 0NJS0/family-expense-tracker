# Copy to backend/.env for local development. Never commit the real file.
# All settings use the FET_ prefix.

FET_ENVIRONMENT=development            # development | test | production
# Percent-encode special characters in the password (@ -> %40, : -> %3A, / -> %2F).
FET_DATABASE_URL=postgresql+psycopg://fet_app:CHANGE_ME@HOMELAB_HOST:5432/fet_dev

# Required in production: 32+ random characters, e.g. `openssl rand -base64 48`.
FET_JWT_SECRET=
FET_ACCESS_TOKEN_TTL_MINUTES=15
FET_REFRESH_TOKEN_TTL_DAYS=60
FET_SESSION_MAX_AGE_DAYS=365
FET_REFRESH_REUSE_GRACE_SECONDS=60

# Comma-separated dashboard origins allowed by CORS (https only in production).
FET_CORS_ORIGINS=
FET_DEFAULT_TIMEZONE=Asia/Dhaka
FET_LOGIN_RATE_LIMIT_PER_MINUTE=10
FET_LOG_LEVEL=INFO

# Receipts: private file storage (a Docker volume in production; never served directly).
FET_RECEIPTS_DIR=var/receipts
FET_MAX_RECEIPT_BYTES=10485760

# Local AI (llama.cpp). Leave the URL empty to turn AI summaries off.
# Used only by the background worker: `uv run python -m app.worker`.
FET_LLAMA_BASE_URL=
FET_LLAMA_API_KEY=
FET_LLAMA_MODEL=CHANGE_ME        # the model id your llama.cpp server reports
FET_LLAMA_TIMEOUT_SECONDS=1800
FET_WORKER_POLL_SECONDS=30
FET_OCR_TIMEOUT_SECONDS=120
