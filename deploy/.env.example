# Copy to deploy/.env on the homelab and fill in. Never commit deploy/.env.

# --- Database (the homelab's PostgreSQL; see deploy/setup-database.sql) -------
# Percent-encode special characters in the password (@ -> %40, : -> %3A, / -> %2F).
FET_DATABASE_URL=postgresql+psycopg://fet_app:CHANGE_ME@host.docker.internal:5432/fet_prod
# The same database for the backup's pg_dump (plain libpq form), WITHOUT the
# password; put the password, as typed (not percent-encoded), on the next line.
BACKUP_DATABASE_URL=postgresql://fet_app@host.docker.internal:5432/fet_prod
BACKUP_DATABASE_PASSWORD=CHANGE_ME

# --- Secrets -----------------------------------------------------------------
# 32+ random characters:  openssl rand -base64 48
FET_JWT_SECRET=

# --- Paths and ports on the homelab --------------------------------------------
# Owned by uid 10001 (the app user):  sudo mkdir -p DIR && sudo chown 10001:10001 DIR
RECEIPTS_DIR=/srv/family-expenses/receipts
BACKUP_DIR=/srv/family-expenses/backups
# The homelab's address on the home network. The site listens ONLY there, so it
# is reachable at home and through your VPN, but not on other
# addresses (e.g. a public IPv6 one). Give the homelab a fixed address (a DHCP
# reservation on the router), or the stack cannot start when the address changes.
WEB_BIND=192.168.x.x
# Phone app and browser: http://WEB_BIND:WEB_PORT. Any free port on the homelab.
WEB_PORT=CHANGE_ME
# Docker network for the app; allow it in pg_hba.conf.
APP_SUBNET=172.30.250.0/24

# --- App -------------------------------------------------------------------------
FET_DEFAULT_TIMEZONE=Asia/Dhaka
FET_LOG_LEVEL=INFO
# Same-origin dashboard: no CORS needed.
FET_CORS_ORIGINS=

# --- Local AI (llama.cpp); leave the URL empty to turn AI summaries off ----------
# For example http://host.docker.internal:<llama-port>
FET_LLAMA_BASE_URL=
FET_LLAMA_API_KEY=
# The model id your llama.cpp server reports (GET /v1/models).
FET_LLAMA_MODEL=CHANGE_ME

# --- Backups -----------------------------------------------------------------------
BACKUP_TIME=02:30
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_MONTHLY=12
